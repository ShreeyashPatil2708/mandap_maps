# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
frontend/dist/

# Environment / secrets (never commit real values)
.env
.env.local
.env.*.local
*.env
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local settings
.claude/

# Internal design reference (not part of the built app; kept out of the repo)
frontend/design-reference/

# Test / coverage
coverage/

# Misc
.cache/
.turbo/

# Private dataset (curated content). Kept out of the public repo; lives in
# RDS/seed source only. Regenerate seed-data.json with backend/db/generate-seed-data.py.
# NOTE: leading slash anchors this to the top-level data/ folder only, so app
# code folders like frontend/src/data/ are NOT ignored.
/data/
backend/db/seed-data.json
# Same private dataset the chatbot uses (the website's seed-data.json copy).
# Shared by hand, never committed. The committed seed-data.example.json documents
# the shape so a fresh clone still runs with placeholder data.
chatbot/seed-data.json

# Python (chatbot FastAPI service)
venv/
.venv/
__pycache__/
*.pyc
.ruff_cache/
# Chatbot build artifact - rebuild with: cd chatbot && python ingest_seed_data.py
chatbot/app/data/faiss_index/

# Terraform (infra/). Never commit: .terraform/ is a local plugin cache, and
# state/tfvars can contain plaintext secrets. The provider lock file
# (.terraform.lock.hcl) IS meant to be committed, so it is not ignored here.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.example.tfvars
crash.log
crash.*.log

claude.md

