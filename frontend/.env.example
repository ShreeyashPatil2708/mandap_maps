# ─────────────────────────────────────────────────────────────
# MandapMaps, Frontend environment (Vite)
# Copy to `.env` and fill in. Only VITE_* vars are exposed to the
# browser bundle, never put secrets here.
# ─────────────────────────────────────────────────────────────

# Base URL of the backend API. Leave empty (the default) to call /api
# same-origin: the Vite proxy handles it locally (see vite.config.js) and
# CloudFront routes it to the API in production.
VITE_API_URL=

# Local-only: where the Vite dev server proxies /api requests.
VITE_DEV_API_PROXY=http://localhost:4000

# Local-only: where the Vite dev server proxies /api/chat requests.
# The chatbot is a separate Python (FastAPI) service; see chatbot/ in the repo.
VITE_DEV_CHATBOT_PROXY=http://localhost:8000

# Public UPI id shown in the "Support Us" section / QR code.
VITE_UPI_ID=yourname@upi
