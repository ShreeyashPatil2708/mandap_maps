# "groq" (fast, hosted, needs internet + key) or "ollama" (local, offline)
LLM_PROVIDER=groq

# ---- Groq ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ---- Ollama (fallback / offline mode) ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

POSTGRES_URL=postgresql://ekdanta:ekdanta@localhost:5432/ekdanta_db
REDIS_URL=redis://localhost:6379/0

# Node API used for live crowd levels (the Vite dev backend by default).
BACKEND_URL=http://localhost:4000

DENSE_WEIGHT=0.65
SPARSE_WEIGHT=0.35
TOP_K=5
MEMORY_TURNS=6
CACHE_TTL_SECONDS=3600

# ---- Security / abuse limits ----
# Comma/JSON list of browser origins allowed to call the API (CORS).
# In production set this to your real site, e.g. ["https://ekdanta.example.com"]
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Shared secret required in the X-API-Key header for /api/ingest.
# Blank = open in local dev; with ENV=production a blank key disables ingestion.
INGEST_API_KEY=
# Per-IP rate limits (slowapi syntax).
CHAT_RATE_LIMIT=20/minute
INGEST_RATE_LIMIT=5/minute
MANDALS_RATE_LIMIT=60/minute
