# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- Runtime ---
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed CORS origins (the frontend URLs).
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
# Leave DATABASE_URL empty to use the discrete PG* vars below.
DATABASE_URL=

PGHOST=localhost
PGPORT=5432
PGDATABASE=ekdantadb
PGUSER=postgres
PGPASSWORD=your_password_here
PGSSL=false

# --- Redis ---
REDIS_URL=redis://localhost:6379
GANPATI_CACHE_TTL=86400

# --- AWS Secrets Manager (leave empty for local dev) ---
AWS_REGION=ap-south-1
DB_SECRET_ID=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
