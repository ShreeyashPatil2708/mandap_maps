[Unit]
Description=MandapMaps Dev API (Node.js, port 3001)
After=network.target redis.service
Requires=redis.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/mandapmaps/dev
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=AWS_REGION=us-east-1
Environment=DB_SECRET_ID=mandapmaps-prod/database
# Override PGDATABASE before loadSecrets runs so the dev DB is used
Environment=PGDATABASE=mandapmaps_dev
Environment=PGSSL=true
Environment=REDIS_URL=redis://localhost:6379
Environment=GANPATI_CACHE_TTL=86400
Environment=CORS_ORIGINS=https://dev.mandapmaps.in
Environment=RATE_LIMIT_WINDOW_MS=60000
Environment=RATE_LIMIT_MAX=1000
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=10
MemoryMax=400M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mandapmaps-dev

[Install]
WantedBy=multi-user.target
