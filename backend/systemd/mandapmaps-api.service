[Unit]
Description=MandapMaps Node API
After=network-online.target redis6.service
Wants=network-online.target

[Service]
Type=simple
User=mandapmaps
Group=mandapmaps
WorkingDirectory=/opt/mandapmaps/repo/backend
EnvironmentFile=/etc/mandapmaps/api.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mandapmaps/repo

[Install]
WantedBy=multi-user.target
